# Database (required). Replace change_me with a private local password.
DATABASE_URL=postgresql+psycopg://assetguard:change_me@localhost:5432/assetguard

# JWT authentication (secret required; generate a long random value privately).
AUTH_JWT_SECRET=replace_with_a_cryptographically_strong_random_secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=60

# Gemini (API key optional unless manual or automatic AI analysis is used).
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Machine ingestion (required for the ingestion API and gateway simulator).
# Generate this key privately and give the same value to the external gateway.
INGESTION_API_KEY=replace_with_a_cryptographically_strong_ingestion_key

# Condition monitoring safe development defaults.
# Statistical sensitivity settings; these are not OEM or safety limits.
MONITORING_MIN_HISTORY=12
MONITORING_BASELINE_WINDOW=30
MONITORING_RECENT_WINDOW=5
MONITORING_TREND_WINDOW=8
MONITORING_WATCH_THRESHOLD=3.0
MONITORING_DEVIATION_THRESHOLD=5.0
MONITORING_TREND_THRESHOLD=2.5
MONITORING_PERSISTENCE_RATIO=0.6
MONITORING_MIN_SCALE_RATIO=0.005
MONITORING_MIN_ABSOLUTE_SCALE=0.000001

# Operational alerting safe development defaults.
# Operational workflow sensitivity; these are not OEM or safety limits.
ALERTING_ENABLED=true
ALERT_ANOMALOUS_ASSESSMENTS_REQUIRED=2
ALERT_COOLDOWN_MINUTES=60

# Optional AI escalation. Disabled by default; manual AI remains available.
AUTO_AI_ESCALATION_ENABLED=false
